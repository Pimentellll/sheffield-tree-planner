# CANOPY application configuration, loaded by deploy/spark/canopyctl.
# `canopyctl install` copies this to state/canopy.env once; edit that copy, never this file.
# Plain KEY=value lines only (no shell expansion). Never add keys, tokens or hosted fallbacks.

# --- Application (FastAPI API + built React UI on ONE loopback origin) -------------
# Always bound to 127.0.0.1. The laptop reaches it only through an SSH tunnel.
CANOPY_PORT=8765
# Add the leaf-off winter case to the synthetic physical runtime (1 = yes, 0 = no).
CANOPY_WINTER=1

# --- Optional local planning agent -------------------------------------------------
# Leave LLM_BASE_URL or LLM_MODEL empty to run without an agent: evaluation, search and
# comparison work unchanged and the UI shows "Planning agent not configured".
# Spark host: the loopback-published vLLM container from inference.compose.yml.
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Must equal an ID the model service lists at /v1/models (vLLM --served-model-name).
LLM_MODEL=tree-planner-local
# Nemotron/vLLM thinking toggle, sent as chat_template_kwargs.enable_thinking.
LLM_ENABLE_THINKING=false
# Only for servers that accept an OpenAI reasoning_effort field (e.g. Ollama: none).
LLM_REASONING_EFFORT=
