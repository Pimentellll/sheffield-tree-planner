# Proposed application configuration, NOT loaded by an implemented backend yet.
# Host process on Spark -> the loopback-published inference container.
# Laptop development -> change only the URL to the SSH tunnel's port 8001.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=tree-planner-local
LLM_ENABLE_THINKING=false
# Frontend talks to the application API, never directly to the model service.
APP_HOST=127.0.0.1
APP_PORT=8080
# Never add private keys, personal provider credentials or hosted fallbacks here.
